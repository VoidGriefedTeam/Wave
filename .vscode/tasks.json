{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "cppbuild",
			"label": "BUILD",
			"command": "cl.exe",
			"args": [
				"/Od",
				"/Zi",
				"/FS",
				"/EHsc",
				"/nologo",
				"/std:c++latest",
				"/I${workspaceFolder}",
				"/I${workspaceFolder}\\THIRD_PARTY\\include",
				"/Ycpch.h",
				"/Fp\"${workspaceFolder}\\pch.pch\"",
				"/Fe${fileDirname}\\${fileBasenameNoExtension}.exe",
				"${workspaceFolder}\\pch.cpp",
				"${file}"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": ["$msCompile"],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"detail": "Unified single-pass MSVC build with PCH"
		}
	]
}
